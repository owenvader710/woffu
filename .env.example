# Example names only. NEVER add real credentials to Git.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Notification features: use staging-only credentials or disable sending.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
RESEND_API_KEY=
INVITE_FROM_EMAIL=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Netlify staging: always isolate from Production. Do not commit real keys.
# Use WOFFU_DEPLOYMENT_MODE=staging for the staging website.
WOFFU_DEPLOYMENT_MODE=staging
# Start read-only; enable writes only after staging credentials are verified.
WOFFU_ENABLE_PREVIEW_MUTATIONS=false
